{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemotionEducationalShot",
  "type": "object",
  "required": ["shot_id", "start_frame", "end_frame", "narrative_purpose", "start_state", "end_state", "key_beats"],
  "properties": {
    "shot_id": {"type": "string"},
    "start_frame": {"type": "integer", "minimum": 0},
    "end_frame": {"type": "integer", "minimum": 1},
    "narrative_purpose": {"type": "string"},
    "start_state": {"type": "object"},
    "end_state": {"type": "object"},
    "key_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "subject", "intent"],
        "properties": {
          "frame": {"type": "integer"},
          "subject": {"type": "string"},
          "intent": {"type": "string"},
          "values": {"type": "object"}
        }
      }
    },
    "camera": {"type": "object"},
    "transition_in": {"type": "object"},
    "transition_out": {"type": "object"},
    "audio_cues": {"type": "array"}
  }
}

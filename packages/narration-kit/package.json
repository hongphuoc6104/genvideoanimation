{
  "name": "@videorender/narration-kit",
  "version": "1.0.0",
  "description": "Canonical V3 offline speech synthesis, alignment, and audio production pipeline for Remotion",
  "author": "videorenderhoathinh",
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tts": {
      "types": "./src/tts/index.ts",
      "import": "./src/tts/index.ts",
      "default": "./src/tts/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0 || ^22.0.0 || ^26.0.0",
    "typescript": "^5.0.0 || ^7.0.0"
  },
  "keywords": [
    "remotion",
    "narration",
    "tts",
    "kokoro",
    "audio-pipeline",
    "offline-speech",
    "karaoke"
  ]
}

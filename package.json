{
  "name": "videorenderhoathinh-root",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "connection-film",
    "motion-kit",
    "packages/*"
  ],
  "scripts": {
    "studio": "npm run studio --prefix connection-film",
    "render": "npm run render --prefix connection-film",
    "render:offline": "npm run render:offline --prefix connection-film",
    "narration:setup": "tsx scripts/setup-narration-models.ts",
    "build:narration": "tsc --project packages/narration-kit/tsconfig.json",
    "build:caption": "tsc --project packages/caption-kit/tsconfig.json",
    "build": "tsc --project packages/narration-kit/tsconfig.json && tsc --project packages/caption-kit/tsconfig.json",
    "typecheck": "tsc --noEmit --project connection-film/tsconfig.json && tsc --noEmit --project motion-kit/tsconfig.json && tsc --noEmit --project packages/narration-kit/tsconfig.json && tsc --noEmit --project packages/caption-kit/tsconfig.json",
    "lint": "node -e \"const fs=require('fs'),cp=require('child_process');const p=fs.existsSync('validators/motion-lint.ts')?'validators/motion-lint.ts':'motion-lint.ts';cp.execSync('tsx '+p,{stdio:'inherit'})\"",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('tests/e2e-runner.ts')){cp.execSync('tsx tests/e2e-runner.ts',{stdio:'inherit'})}else{console.log('E2E runner planned for later milestones.')}\"",
    "test:v3": "tsx tests/e2e/run-e2e-tests.ts",
    "test:e2e": "tsx tests/e2e/run-e2e-tests.ts",
    "link-packages": "node -e \"const fs=require('fs'),path=require('path');const t1=path.resolve(__dirname,'connection-film/node_modules/motion-kit'),s1=path.resolve(__dirname,'motion-kit');if(!fs.existsSync(t1)){try{fs.symlinkSync(s1,t1,'junction')}catch(e){}} const scopeDir=path.resolve(__dirname,'connection-film/node_modules/@videorender');if(!fs.existsSync(scopeDir)){fs.mkdirSync(scopeDir,{recursive:true})} const t2=path.resolve(scopeDir,'narration-kit'),s2=path.resolve(__dirname,'packages/narration-kit');if(!fs.existsSync(t2)){try{fs.symlinkSync(s2,t2,'junction')}catch(e){}} const t3=path.resolve(__dirname,'connection-film/node_modules/narration-kit');if(!fs.existsSync(t3)){try{fs.symlinkSync(s2,t3,'junction')}catch(e){}} const t4=path.resolve(scopeDir,'caption-kit'),s4=path.resolve(__dirname,'packages/caption-kit');if(!fs.existsSync(t4)&&fs.existsSync(s4)){try{fs.symlinkSync(s4,t4,'junction')}catch(e){}} const t5=path.resolve(__dirname,'connection-film/node_modules/caption-kit');if(!fs.existsSync(t5)&&fs.existsSync(s4)){try{fs.symlinkSync(s4,t5,'junction')}catch(e){}} const rootScope=path.resolve(__dirname,'node_modules/@videorender');if(!fs.existsSync(rootScope)){fs.mkdirSync(rootScope,{recursive:true})} const t6=path.resolve(rootScope,'caption-kit');if(!fs.existsSync(t6)&&fs.existsSync(s4)){try{fs.symlinkSync(s4,t6,'junction')}catch(e){}} const t7=path.resolve(__dirname,'node_modules/caption-kit');if(!fs.existsSync(t7)&&fs.existsSync(s4)){try{fs.symlinkSync(s4,t7,'junction')}catch(e){}} console.log('Linked workspace packages -> connection-film/node_modules')\"",
    "link-kit": "npm run link-packages",
    "postinstall": "npm run link-packages",
    "validate:typography": "tsx validators/validate-mobile-typography.ts connection-film/src/scopus-explainer",
    "validate:shotspec": "tsx validators/validate-shot-spec.ts connection-film/src/scopus-explainer/shot-spec.json",
    "validate:ownership": "tsx validators/validate-audio-ownership.ts",
    "validate:portability": "tsx validators/validate-portability.ts",
    "validate:preview-rubric": "tsx validators/validate-preview-rubric.ts out/preview-360x640.mp4 --timeline connection-film/src/scopus-explainer/semantic-timeline.json",
    "validate:visual-semantics": "tsx validators/validate-visual-semantics.ts connection-film/src/scopus-explainer/scenes",
    "extract:contact-sheet": "tsx validators/extract-contact-sheet.ts connection-film/src/scopus-explainer/semantic-timeline.json out/preview-360x640.mp4 out/contact-sheets/scopus-explainer",
    "validate:m1": "npm run validate:shotspec && npm run validate:ownership && npm run validate:portability",
    "render:gpu:crispr": "remotion render connection-film/src/index.ts CrisprCas9-TikTok916 out/crispr-cas9-1080p.mp4 --concurrency=4",
    "render:gpu:steam": "remotion render connection-film/src/index.ts SteamEngineCycle out/steam-engine-1080p.mp4 --concurrency=4",
    "render:gpu:git": "remotion render connection-film/src/index.ts GitDagModel-TikTok916 out/git-dag-1080p.mp4 --concurrency=4",
    "render:gpu:scopus": "remotion render connection-film/src/index.ts ScopusResearchGap-TikTok916 out/final-v3_3.mp4 --concurrency=4",
    "render:gpu:all": "npm run render:gpu:crispr && npm run render:gpu:steam && npm run render:gpu:git && npm run render:gpu:scopus",
    "v3.3:gate": "tsx scripts/run-v3_3-gate.ts"
  },
